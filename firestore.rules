rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Admin is granted ONLY by a verified custom claim or an exact-match
      // allow-listed identity. The previous `.*admin.*` substring match was a
      // privilege-escalation hole (any email containing "admin" gained full
      // database access) and has been removed.
      return (
        request.auth != null &&
        (
          request.auth.token.admin == true ||
          (
            request.auth.token.email != null &&
            (
              request.auth.token.email == 'correctnowapp@gmail.com' ||
              request.auth.token.email.matches('.*@correctnow\\.app$')
            )
          )
        )
      );
    }

    // Entitlement / billing / usage fields that ONLY the server (Admin SDK,
    // which bypasses rules) or an admin may write. Clients must never set these
    // on their own user document — otherwise a user could grant themselves Pro
    // straight from the browser console, bypassing all payment verification.
    function protectedUserFields() {
      return [
        'plan', 'wordLimit', 'credits', 'creditsUsed', 'creditsResetDate',
        'subscriptionStatus', 'subscriptionId', 'razorpaySubscriptionId',
        'stripeSubscriptionId', 'stripeCustomerId', 'paymentGateway',
        'subscriptionCreatedAt', 'subscriptionUpdatedAt',
        'subscriptionCurrentPeriodEnd', 'subscriptionPeriodStart',
        'lastPaymentAmount', 'lastPaymentId', 'razorpayPaidCount',
        'razorpayTotalCount', 'addonCredits', 'addonCreditsExpiryAt',
        'adminCredits', 'adminCreditsExpiryAt', 'adminPlanExpiresAt',
        'dailyChecksUsed', 'lastCheckDate'
      ];
    }

    // Allow any authenticated user to read coupons (needed for payment/admin pages)
    // This must come BEFORE the catch-all admin rule
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SEO language pages - public read access for active pages
    match /seoPages/{pageId} {
      allow read: if true; // Public read access for landing pages
      allow write: if isAdmin(); // Only admins can create/update/delete
    }

    // Admin has full access to all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // A user may create their own profile doc as long as it carries NO
      // entitlement/billing fields (those are server-owned).
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(protectedUserFields());

      // A user may update their own profile, but the set of CHANGED keys must
      // not touch any protected entitlement/billing/usage field.
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());

      // No client-side deletes of the user doc.
      allow delete: if false;
    }
    
    match /users/{userId}/docs/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId && resource.data.archivedAt is string;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views is int &&
        request.resource.data.views >= (resource.data.views is int ? resource.data.views : 0)
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if
          request.resource.data.keys().hasOnly(['name', 'message', 'createdAtIso']) &&
          request.resource.data.name is string &&
          request.resource.data.message is string &&
          request.resource.data.createdAtIso is string &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.message.size() > 0 &&
          request.resource.data.message.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /suggestions/{suggestionId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /userChecks/{checkId} {
      allow read: if isAdmin(); // Only admins can view user check history
      allow write: if false; // Written by server only
    }
  } 
}
 