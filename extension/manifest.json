{
  "manifest_version": 3,
  "name": "CorrectNow - Grammar Checker",
  "version": "1.2.4",
  "description": "Check grammar and spelling on any webpage with CorrectNow",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "CorrectNow Grammar Checker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-extension-id.js",
        "android-chrome-512x512.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://correctnow.app/*",
      "http://localhost:*/*",
      "http://localhost:5173/*",
      "http://localhost:8080/*"
    ]
  }
}
